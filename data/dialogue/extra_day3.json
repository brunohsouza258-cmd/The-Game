      "color": "#4DB6AC",
      "sprite": "res://assets/characters/alice.png",
      "pose": "surprised",
      "text": "...Como você sabe que é canhoto?",
      "next": "n6"
    },
    "n6": {
      "speaker": "",
      "sprite": "",
      "text": "A Maya abre a boca. Fecha. Nenhuma das duas percebe {player_name}, parado na curva do corredor.",
