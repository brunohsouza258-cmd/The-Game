    "n3": {
      "speaker": "Alice",
      "color": "#4DB6AC",
      "sprite": "res://assets/characters/alice.png",
      "pose": "angry",
      "text": "Tem iniciais, Maya. K.M. Riscadas com compasso, de baixo pra cima. Quem escreve de baixo pra cima?",
